
[settings]
database-backend = papis
use-cache = True
default-library=papers
file-browser = vifm
add-edit = True
add-open = True
add-folder-name = {doc[year]}-{doc[author_list][0][family]}-{doc[title]}
add-file-name = {doc[year]}-{doc[author_list][0][family]}-{doc[title]}
ref-format = {doc[author_list][0][family]}{doc[year]}{doc[month]}
extra-bibtex-keys = ["extra", "abstract"]
extra-bibtex-types = ["thesis"]
bibtex-unicode = True

# --- library history and checks (wayfinder: Groundwork) ----------------------
# Every papis change is a git commit in the library repo (PDFs are gitignored).
use-git = True
# Duplicate detection on add; papis_id first so bib entries still match by id.
unique-document-keys = ["papis_id", "doi", "isbn", "url"]
# papis doctor: duplicated refs and DOIs, and References without a PDF.
doctor-duplicated-keys-keys = ["ref", "doi"]
doctor-keys-missing-keys = ["title", "author", "author_list", "ref", "files"]

# --- fzf picker -------------------------------------------------------------
# Use fzf as the picker so we can add custom key bindings. Each entry fed to
# fzf is three "@@"-separated fields (@@ chosen because it never occurs in
# bibliographic data and, unlike a literal tab, survives editing):
#   1: a plain one-line citation  (unused by the bindings now)
#   2: the papis_id               -> used to look the doc up for the preview
#   3: the coloured display       -> the only field shown / searched
picktool = fzf
fzf-header-format = {doc[author]} ({doc[year]}). {doc[title]}. {doc[journal]}.@@{doc[papis_id]}@@{c.Fore.MAGENTA}{doc[title]:<70.70}{c.Style.RESET_ALL} :: {c.Fore.CYAN}{doc[author]:<20.20}{c.Style.RESET_ALL} {c.Fore.YELLOW}«{doc[year]:4}»{c.Style.RESET_ALL} {c.Fore.GREEN}{doc[tags]}{c.Style.RESET_ALL}
# NB: literal '%' must be doubled ('%%') — papis' configparser treats a single
# '%' as interpolation syntax.
# --with-nth restricts BOTH what is displayed and what is searched to field 3,
# so no separate --nth is needed (adding one would look for a 3rd field inside
# the already-collapsed display and match nothing).
fzf-extra-flags = ["--ansi", "--multi", "-i", "--delimiter", "@@", "--with-nth", "3..", "--preview", "$HOME/.config/papis/scripts/papis-fzf-preview {2}", "--preview-window", "bottom:40%%:wrap"]
# Key bindings, header, normal mode and the ? help come from fzf.ini, which
# papis-action generates from its action table (dotfiles-nixos papis/).
# ----------------------------------------------------------------------------


[include]
# generated by dotfiles-nixos papis/default.nix; sets fzf-extra-bindings
fzf = ~/.config/papis/fzf.ini

[tui]
editmode = vi
options_list.unselected_margin_style =

[papers]
dir = ~/sync/bibliography/paper
opentool = zathura

[books]
dir = ~/sync/bibliography/books
opentool = zathura

