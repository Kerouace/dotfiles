#! /usr/bin/env bash
# papis-short-help: Key-binding cheat sheet for the fzf picker (bound to '?' there)
#
# Printed into the fzf preview pane when '?' is pressed. Move to any entry to
# switch the preview back to the document metadata.

cat <<'EOF'
  papis picker — key bindings

  Enter     open the document
  Ctrl-O    open the document
  Ctrl-E    edit info.yaml
  Ctrl-B    browse (URL / DOI)
  Ctrl-Q    edit notes
  Ctrl-Y    copy one-line citation to clipboard  (-> notification)
  Ctrl-S    jump (fzf quick-jump)
  ?         show this help

  Tab       mark / unmark (multi-select)
  Type to filter  ·  Up/Down move  ·  Esc cancel
EOF
